.venv/
venv/
ENV/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Python
*.egg-info/
dist/
build/
*.egg

# Byte-compiled / Cached
*.py[cod]
*$py.class
