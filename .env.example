# =============================================================================
# EstateHub — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git!
#
# On PythonAnywhere, set these in your WSGI file or via the dashboard:
#   import os
#   os.environ['DJANGO_SECRET_KEY'] = 'your-production-secret-key'
#   os.environ['DJANGO_DEBUG'] = 'False'
# =============================================================================

# A unique, unpredictable secret key for cryptographic signing.
# Generate one at: https://djecrety.ir/
DJANGO_SECRET_KEY=your-production-secret-key-here

# Set to True for local development, False for production.
DJANGO_DEBUG=False
